{
  "name": "rainform",
  "version": "2.0.0",
  "private": true,
  "description": "雨境 RainScope · 暴雨数据可视化：把真实暴雨逐时数据转化为交互式 Three.js/WebGL 雨景。An interactive Three.js/WebGL storm rainfall visualization driven by fact-anchored hourly data.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "shiqiyu",
  "homepage": "https://storm-rainfall-visualization.shiqiyu-ai.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/1-1-1-11/RainScope.git"
  },
  "bugs": {
    "url": "https://github.com/1-1-1-11/RainScope/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audio:generate": "node scripts/generate-rain-audio.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:sites": "npm run check && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check:project": "node scripts/check-project.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check": "npm run check:project && npm run build && npm run check:dist",
    "test:sites": "node --test tests/sites-worker.test.mjs tests/quality-limits.test.mjs"
  },
  "dependencies": {
    "three": "^0.165.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
